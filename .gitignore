# Mitsuro development files

# Local agent configuration
.claude/worktrees/

# Build outputs
target/
.fastembed_cache/
/.tmp/
/.canvas-target/
/.canvas-target-smoke/
/.canvas-target-smoke-*/
/.canvas-smoke/
**/target/
**/dist/
**/.mitsuro-shadow/
# Canonical project-local runtime/private state. Keep authored
# `.mitsuro/settings.json`, skills, policies, and extensions trackable.
**/.mitsuro/tool-output/
**/.mitsuro/reports/
**/.mitsuro/mailbox/
**/.mitsuro/logs/
**/.mitsuro/run/
**/.mitsuro/tokens/
**/.mitsuro/backups/
**/.mitsuro/hive/
**/.mitsuro/plugins/
**/.mitsuro/plans/
**/.mitsuro/mitsuro.db
**/.mitsuro/mitsuro.db-*
# Pre-migration generated shadow output remains ignored until cleanup.
**/.krusty-shadow/

# Python test caches
**/__pycache__/
*.py[cod]

# MCP configuration (user-specific)
.mcp.json
.mcp_overrides.json

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Frontend build
node_modules/
frontend/node_modules
frontend/build
.expo/
coverage/

# Lockfile policy: Bun only
**/package-lock.json
**/pnpm-lock.yaml
**/yarn.lock

# Never publish internal working material from this repo
apps/**/legacy*/
apps/**/legacy-*/
/docs/archive/
/docs/drafts/
/docs/internal/
/research/
/experiments/
/scratch/
/artifacts/
/STAGING_NOTES.md
/AUDIT.md
/AUDIT_TODO.md
*.xcresult/
*.memgraph
*.trace
/docs/plans/_orch-verify-matrix.txt

# Secrets, credentials, and keys — never commit these
.env
.env.*
!.env.example
credentials.json
oauth.json
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
.krusty/
